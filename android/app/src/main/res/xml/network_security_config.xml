<?xml version="1.0" encoding="utf-8"?>
<!-- ATR-SYN-03: HTTPS only, system certificate authorities only (no user-added CAs). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
